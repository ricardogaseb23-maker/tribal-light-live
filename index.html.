
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tribal Light Live</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#0d1422;color:white;font-family:Arial,sans-serif}
main{max-width:480px;margin:auto;padding:22px}
h1{font-size:24px}
h2{font-size:18px}
.preview{height:360px;background:#19263b;border-radius:18px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;text-align:center}
video{width:100%;height:100%;object-fit:cover;position:absolute}
#placeholder{z-index:1;color:#aebcd2}
.controls{display:flex;gap:10px;margin-top:15px}
button{background:#355a8c;color:white;border:0;border-radius:12px;padding:14px;flex:1;font-weight:bold;cursor:pointer}
.card{background:#18253a;padding:18px;border-radius:15px;margin-top:20px}
.platform{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #35445a}
.status{color:#e6b36c;font-size:13px}
.live{width:100%;margin-top:20px;background:#575c68}
small{color:#9daec6}
</style>
</head>
<body>
<main>
<h1>✦ Tribal Light Live</h1>
<p>Your personal streaming studio</p>
<div class="preview">
<video id="camera" autoplay muted playsinline></video>
<div id="placeholder">Camera Preview<br>Tap Start Camera</div>
</div>
<div class="controls">
<button onclick="startCamera()">Start Camera</button>
<button onclick="flipCamera()">Flip Camera</button>
</div>
<p id="message"></p>
<div class="card">
<h2>Streaming Destinations</h2>
<div class="platform">TikTok <span class="status">Not connected</span></div>
<div class="platform">YouTube <span class="status">Not connected</span></div>
<div class="platform">Facebook <span class="status">Not connected</span></div>
</div>
<button class="live" disabled>GO LIVE — COMING SOON</button>
<p><small>Prototype version: camera testing only. No live broadcasting yet.</small></p>
</main>
<script>
let stream=null;
let facing="user";
async function startCamera(){
try{
if(stream)stream.getTracks().forEach(t=>t.stop());
stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:facing},audio:false});
document.getElementById("camera").srcObject=stream;
document.getElementById("placeholder").style.display="none";
document.getElementById("message").textContent="Camera ready";
}catch(e){
document.getElementById("message").textContent="Camera error: "+e.message;
}
}
function flipCamera(){
facing=facing==="user"?"environment":"user";
startCamera();
}
</script>
</body>
</html>
